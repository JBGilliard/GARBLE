                  {
                    "href": "crates/identity/src/room.rs",
                    "rel": "reference",
                    "text": "fn check_message"
                  },
                  {
                    "href": "crates/client/src/lib.rs",
                    "rel": "reference",
                    "text": "IntegrityHold"
                  },
                  {
                    "href": "scripts/money-demo.sh",
                    "rel": "reference"
                  }
                ],
                "props": [

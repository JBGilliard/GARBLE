      {
        "control-implementations": [
          {
            "description": "NIST SP 800-53 Rev 5 controls implemented by log.",
            "implemented-requirements": [
              {
                "control-id": "au-10",
                "description": "Every decision, permit or deny, is a leaf in an append-only Merkle log. After each request the DS signs a checkpoint with its ML-DSA-87 log key. A client keeps the last checkpoint it accepted and refuses one that isn't signed by the trusted key or doesn't extend it, then stops sending. `garble log verify` proves each readable entry is in the signed tree. No witnesses or cosignatures yet, and the first checkpoint is trusted on first use.",
                "links": [
                  {
                    "href": "crates/tlog/src/proof.rs",
                    "rel": "reference",
                    "text": "pub fn verify_inclusion"
                  },
                  {
                    "href": "crates/tlog/src/proof.rs",
                    "rel": "reference",
                    "text": "pub fn verify_consistency"
                  },
                  {
                    "href": "crates/tlog/src/note.rs",
                    "rel": "reference",
                    "text": "pub fn sign_checkpoint"
                  },
                  {
                    "href": "crates/tlog/src/note.rs",
                    "rel": "reference",
                    "text": "pub fn open_checkpoint"
                  },
                  {

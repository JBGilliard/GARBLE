      {
        "control-implementations": [
          {
            "description": "NIST SP 800-53 Rev 5 controls implemented by ds.",
            "implemented-requirements": [
              {
                "control-id": "ac-3.3",
                "description": "Access to rooms and to the audit log is decided by one pure function, policy::decide, from the subject's issuer-signed attributes and the object's marking. The DS runs it on room creation, every add, every message and every log read; a subject whose clearance doesn't dominate the room ceiling (or the entry's marking) is denied, and the denial is logged. The rule is not discretionary: no member or steward can grant access past what the attributes cover. Because membership requires clearance for the ceiling and messages must sit within it, a member cleared for the ceiling is cleared for every message in the room.",
                "links": [
                  {
                    "href": "crates/policy/src/lib.rs",
                    "rel": "reference",
                    "text": "pub fn decide"
                  },
                  {
                    "href": "crates/markings/src/lattice.rs",
                    "rel": "reference",
                    "text": "pub fn dominates"
                  },
                  {
                    "href": "crates/ds/src/main.rs",
                    "rel": "reference",
                    "text": "fn decided"
                  }
                ],
                "props": [
                  {
                    "name": "responsibility",
                    "ns": "https://garble.invalid/ns/oscal",
                    "value": "provided"
                  },
                  {
                    "name": "test",

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The webview may call the console commands and listen for core events. Nothing else: no fs, shell, window or path access.",
  "windows": ["main"],
  "permissions": [
    "allow-list-rooms",
    "allow-open-room",
    "allow-create-room",
    "allow-validate-marking",
    "allow-send",
    "allow-banner",
    "allow-add-member",
    "allow-remove-member",
    "allow-denial",
    "allow-watermark",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
